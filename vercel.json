{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "fluid": true,
  "crons": [
    {
      "path": "/api/admin/offers/expire",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/comparator-refresh?mode=top50",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/comparator-refresh?mode=all",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sales-agents/run",
      "schedule": "*/15 * * * *"
    }
  ]
}
