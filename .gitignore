# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server.log
build.result.log
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.vercel_env_check*.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch/test files
.tmp_*.js
test-ml-*.js
test-rainforest*.js
temp/
supabase/.temp/
docs/apostila-radar-smart-painel-admin.pdf

# runtime logs / browser session data (local automation, never commit — tokens/userDataDir hold live session cookies)
log/
tokens/
userDataDir/
