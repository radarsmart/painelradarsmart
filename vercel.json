{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "app/api/tiktok-engine/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/tiktok-engine/distribute/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/distribute-scheduled/route.ts": {
      "maxDuration": 60
    },
    "app/api/scrape/extract/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/admin/blog/sync-elite",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin/distribution/elite-flush",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/admin/offers/expire",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/public-offers-refresh?limit=40&mode=staleFirst",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/awin/automation/run",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/comparator-refresh?mode=top50",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/comparator-refresh?mode=all",
      "schedule": "0 2 * * *"
    }
  ]
}
